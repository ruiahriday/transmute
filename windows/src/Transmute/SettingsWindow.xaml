<Window x:Class="Transmute.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transmute Settings" Width="520" Height="680" MinWidth="440" MinHeight="400"
        Style="{StaticResource BaseWindow}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="pack://application:,,,/Assets/app.ico">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,10">
            <Button Content="Done" Style="{StaticResource Primary}" MinWidth="90" HorizontalAlignment="Right" IsDefault="True" IsCancel="True" Click="OnDone" />
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,6,20,20">
                <TextBlock Text="Output" Style="{StaticResource SectionTitle}" />
                <RadioButton x:Name="BesideOriginal" Content="Save results next to the original" Margin="0,3" Click="OnOutputMode" />
                <RadioButton x:Name="InFolder" Content="Save results in a folder" Margin="0,3" Click="OnOutputMode" />
                <DockPanel x:Name="FolderRow" Margin="22,4,0,4">
                    <Button DockPanel.Dock="Right" Content="Choose…" Click="OnChooseFolder" Margin="8,0,0,0" />
                    <TextBlock x:Name="FolderLabel" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Secondary}" />
                </DockPanel>
                <CheckBox x:Name="RevealBox" Content="Show results in File Explorer when done" Click="OnChanged" />

                <TextBlock Text="Office documents" Style="{StaticResource SectionTitle}" />
                <CheckBox x:Name="OfficeBox" Content="Use Microsoft Office or LibreOffice when installed" Click="OnChanged" />
                <TextBlock x:Name="OfficeStatus" Style="{StaticResource Caption}" Margin="22,2,0,0" />

                <TextBlock Text="Drag wheel" Style="{StaticResource SectionTitle}" />
                <CheckBox x:Name="WheelBox" Content="Show a wheel when I hold a key while dragging files" Click="OnChanged" />
                <Grid Margin="22,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Formats wheel" VerticalAlignment="Center" />
                    <ComboBox x:Name="ConvertKey" Grid.Column="1" Margin="0,2" SelectionChanged="OnKeyChanged" />
                    <TextBlock Text="Tools wheel" Grid.Row="1" VerticalAlignment="Center" />
                    <ComboBox x:Name="ToolsKey" Grid.Row="1" Grid.Column="1" Margin="0,2" SelectionChanged="OnKeyChanged" />
                    <TextBlock Text="Actions wheel" Grid.Row="2" VerticalAlignment="Center" />
                    <ComboBox x:Name="ActionsKey" Grid.Row="2" Grid.Column="1" Margin="0,2" SelectionChanged="OnKeyChanged" />
                </Grid>
                <TextBlock x:Name="KeyNote" Style="{StaticResource Caption}" Margin="22,6,0,0" />
                <Button Content="Customize Wheels…" HorizontalAlignment="Left" Margin="22,10,0,0" Click="OnCustomizeWheels" />
                <TextBlock Style="{StaticResource Caption}" Margin="22,4,0,0"
                           Text="Choose which formats, tools and actions each wheel shows for each kind of file, and where they sit." />

                <TextBlock Text="Floating files" Style="{StaticResource SectionTitle}" />
                <CheckBox x:Name="ShakeBox" Content="Open when I shake files while dragging them" Click="OnChanged" />
                <CheckBox x:Name="EdgeBox" Content="Open when I drag files to the middle of the top edge of the screen" Click="OnChanged" />

                <TextBlock Text="General" Style="{StaticResource SectionTitle}" />
                <CheckBox x:Name="LoginBox" Content="Start Transmute when I sign in to Windows" Click="OnLogin" />
                <TextBlock Style="{StaticResource Caption}" Margin="22,2,0,0"
                           Text="It waits in the notification area (by the clock), ready for the drag wheel and floating files." />

                <TextBlock Text="Beta" Style="{StaticResource SectionTitle}" />
                <TextBlock x:Name="VersionLabel" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="Send Feedback…" Click="OnFeedback" Margin="0,0,8,0" />
                    <Button Content="Copy PC Details" Click="OnCopyDetails" />
                </StackPanel>
                <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                           Text="Send Feedback opens a short form on GitHub (it needs a free GitHub account). Or copy your PC's details and paste them into a message to whoever sent you Transmute." />

                <TextBlock Text="ffmpeg" Style="{StaticResource SectionTitle}" />
                <TextBlock x:Name="FfmpegLabel" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
