<Window x:Class="Transmute.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Transmute.App"
        Title="Spinform" Width="800" Height="640" MinWidth="680" MinHeight="520"
        Style="{StaticResource BaseWindow}" AllowDrop="True" WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app.ico">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <DataTemplate x:Key="JobRow" DataType="{x:Type local:Job}">
            <Border x:Name="Card" Background="{StaticResource Glass}" BorderBrush="{StaticResource GlassEdge}" BorderThickness="1"
                    CornerRadius="14" Padding="12,10" Margin="2,4">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.08" Color="#1E1B3A" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="11" Background="{Binding KindBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding KindBadge}" Foreground="White" FontWeight="Bold" FontSize="10.5"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="13" FontWeight="SemiBold" ToolTip="{Binding Path}" />
                        <TextBlock Text="{Binding Details}" Style="{StaticResource Caption}" />
                        <TextBox Text="{Binding Message, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                 TextWrapping="Wrap" FontSize="12" Padding="0" MinHeight="0" MaxHeight="54" Margin="0,2,0,0">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Foreground" Value="{StaticResource Success}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Message}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Failed">
                                            <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <ProgressBar Width="110" Maximum="1" Value="{Binding Fraction, Mode=OneWay}" Margin="0,0,10,0"
                                     Visibility="{Binding IsRunning, Converter={StaticResource Visible}}" />
                        <Button Style="{StaticResource Flat}" Content="Show in folder" Click="OnShow" Foreground="{StaticResource Accent}"
                                Visibility="{Binding HasOutputs, Converter={StaticResource Visible}}" />
                        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="4,0,8,0" FontSize="14" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <ScaleTransform />
                            </TextBlock.RenderTransform>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Secondary}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="Done">
                                            <Setter Property="Foreground" Value="{StaticResource Success}" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                            <Setter Property="FontSize" Value="17" />
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.2" To="1" Duration="0:0:0.45">
                                                            <DoubleAnimation.EasingFunction><ElasticEase Oscillations="1" Springiness="4" /></DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.2" To="1" Duration="0:0:0.45">
                                                            <DoubleAnimation.EasingFunction><ElasticEase Oscillations="1" Springiness="4" /></DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Failed">
                                            <Setter Property="Foreground" Value="{StaticResource Warning}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Queued">
                                            <Setter Property="FontSize" Value="12" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Content="✎  Edit" Click="OnEdit" Margin="0,0,4,0" ToolTip="Open in the editor; the result is saved as a copy"
                                Visibility="{Binding CanEdit, Converter={StaticResource Visible}}" />
                        <Button Style="{StaticResource Flat}" Content="ⓘ" FontSize="15" Click="OnInfo" ToolTip="View and edit metadata"
                                Visibility="{Binding HasInfo, Converter={StaticResource Visible}}" />
                        <Button Style="{StaticResource Flat}" Content="✕" Foreground="{StaticResource Secondary}" Click="OnRemove" ToolTip="Remove from list" />
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Card" Property="Background" Value="#F2FFFFFF" />
                    <Setter TargetName="Card" Property="BorderBrush" Value="#668B5CF6" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Accent}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Rows slide up and fade in as they're added; no default blue selection box. -->
        <Style x:Key="RowContainer" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.35" />
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="16" To="0" Duration="0:0:0.4">
                                <DoubleAnimation.EasingFunction><BackEase Amplitude="0.4" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Soft colour glows drifting behind everything (animated in MainWindow.xaml.cs). -->
        <Grid x:Name="Aurora" IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse x:Name="GlowA" Width="560" Height="560" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-200,-220,0,0">
                <Ellipse.Fill>
                    <RadialGradientBrush><GradientStop Color="#608B5CF6" Offset="0" /><GradientStop Color="#008B5CF6" Offset="1" /></RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="GlowB" Width="620" Height="620" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-160,-260,0">
                <Ellipse.Fill>
                    <RadialGradientBrush><GradientStop Color="#4CEC4899" Offset="0" /><GradientStop Color="#00EC4899" Offset="1" /></RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="GlowC" Width="600" Height="600" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-330">
                <Ellipse.Fill>
                    <RadialGradientBrush><GradientStop Color="#4C4338CA" Offset="0" /><GradientStop Color="#004338CA" Offset="1" /></RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
            </Ellipse>
        </Grid>

        <DockPanel Margin="16,12,16,16">
            <!-- Header -->
            <DockPanel DockPanel.Dock="Top" Margin="2,0,2,10">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Content="＋  Add Files" Click="OnAddFiles" Margin="0,0,6,0" />
                    <Button Content="Add Folder" Click="OnAddFolder" Margin="0,0,6,0" />
                    <Button x:Name="ClearButton" Content="Clear" Click="OnClear" Margin="0,0,6,0" />
                    <Button Content="Feedback" Click="OnFeedback" Margin="0,0,6,0" />
                    <Button Content="⚙" FontSize="15" Padding="9,3" Click="OnSettings" ToolTip="Settings" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- The Spinform mark (the icon's symbol without its tile), turning slowly in MainWindow.xaml.cs. -->
                    <Image x:Name="HeaderMark" Source="pack://application:,,,/Assets/mark.png" Width="40" Height="40" Margin="0,0,10,0"
                           RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform><RotateTransform /></Image.RenderTransform>
                        <Image.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.30" Color="#8B5CF6" />
                        </Image.Effect>
                    </Image>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Spinform" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Brand}" />
                        <TextBlock x:Name="Summary" Text="Drop. Pick a format. Done." Style="{StaticResource Caption}" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <!-- Controls -->
            <Border DockPanel.Dock="Bottom" Style="{StaticResource GlassCard}" Padding="16,14" Margin="0,12,0,0">
                <StackPanel>
                    <Border Background="#121E1B3A" CornerRadius="17" HorizontalAlignment="Left" Padding="2" Margin="0,0,0,12">
                        <Grid>
                            <Border x:Name="SegmentHighlight" Background="{StaticResource Brand}" CornerRadius="15" HorizontalAlignment="Left" Margin="2">
                                <Border.RenderTransform><TranslateTransform x:Name="SegmentShift" /></Border.RenderTransform>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.35" Color="#8B5CF6" />
                                </Border.Effect>
                            </Border>
                            <StackPanel x:Name="Segments" Orientation="Horizontal">
                                <RadioButton x:Name="ConvertTab" Style="{StaticResource Segment}" Content="⇄  Convert" IsChecked="True" Checked="OnMode" />
                                <RadioButton x:Name="CompressTab" Style="{StaticResource Segment}" Content="⇲  Compress" Checked="OnMode" />
                                <RadioButton x:Name="ToolsTab" Style="{StaticResource Segment}" Content="✦  Tools" Checked="OnMode" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid x:Name="Panels">
                        <Grid.RenderTransform><TranslateTransform /></Grid.RenderTransform>
                        <!-- Convert -->
                        <StackPanel x:Name="ConvertPanel">
                            <TextBlock x:Name="NoFormats" Text="Add some files to choose output formats." Foreground="{StaticResource Secondary}" Margin="0,0,0,6" />
                            <StackPanel x:Name="FormatPickers" />
                            <DockPanel Margin="0,6,0,0" LastChildFill="False">
                                <StackPanel x:Name="QualityRow" Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                                    <TextBlock Text="Quality" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Slider x:Name="QualitySlider" Width="140" Minimum="0.1" Maximum="1" VerticalAlignment="Center" ValueChanged="OnQuality" />
                                    <TextBlock x:Name="QualityLabel" Width="44" VerticalAlignment="Center" Margin="6,0,12,0" />
                                </StackPanel>
                                <CheckBox x:Name="StripBox" Content="Remove metadata" VerticalAlignment="Center" DockPanel.Dock="Left" Click="OnStripToggle" />
                                <Button DockPanel.Dock="Right" x:Name="ConvertButton" Style="{StaticResource Primary}" Content="Convert" MinWidth="96" Click="OnConvert" IsDefault="True" />
                                <Button DockPanel.Dock="Right" x:Name="CancelConvert" Content="Cancel" Margin="0,0,8,0" Click="OnCancel" />
                            </DockPanel>
                        </StackPanel>

                        <!-- Compress -->
                        <StackPanel x:Name="CompressPanel" Visibility="Collapsed">
                            <DockPanel LastChildFill="False">
                                <RadioButton x:Name="ByPercent" Content="Percentage" IsChecked="True" VerticalAlignment="Center" Margin="0,0,10,0" Checked="OnCompressBy" DockPanel.Dock="Left" />
                                <RadioButton x:Name="BySize" Content="Target size" VerticalAlignment="Center" Margin="0,0,16,0" Checked="OnCompressBy" DockPanel.Dock="Left" />
                                <StackPanel x:Name="PercentRow" Orientation="Horizontal" DockPanel.Dock="Left">
                                    <Slider x:Name="PercentSlider" Width="160" Minimum="10" Maximum="90" Value="50" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="OnPercent" />
                                    <TextBlock x:Name="PercentLabel" Text="to 50% of original" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </StackPanel>
                                <StackPanel x:Name="SizeRow" Orientation="Horizontal" Visibility="Collapsed" DockPanel.Dock="Left">
                                    <TextBox x:Name="TargetMB" Text="5" Width="60" />
                                    <TextBlock Text="MB per file" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </StackPanel>
                                <Button DockPanel.Dock="Right" x:Name="CompressButton" Style="{StaticResource Primary}" Content="Compress" MinWidth="96" Click="OnCompress" />
                                <Button DockPanel.Dock="Right" x:Name="CancelCompress" Content="Cancel" Margin="0,0,8,0" Click="OnCancel" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                                       Text="Works on images, video, audio and PDFs; other files are skipped. Originals are never changed." />
                        </StackPanel>

                        <!-- Tools -->
                        <StackPanel x:Name="ToolsPanel" Visibility="Collapsed">
                            <WrapPanel>
                                <WrapPanel.Resources>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Margin" Value="0,0,6,6" />
                                    </Style>
                                </WrapPanel.Resources>
                                <Button x:Name="MergeButton" Content="Merge PDFs" Click="OnMerge" />
                                <Button x:Name="ImagesPdfButton" Content="Images → PDF" Click="OnImagesToPdf" />
                                <Button x:Name="SplitButton" Content="Split PDF Pages" Click="OnSplit" />
                                <Button x:Name="JoinButton" Content="Join Videos" Click="OnJoin" ToolTip="Joins the videos in list order into one MP4" />
                                <Button x:Name="ZipButton" Content="Zip All" Click="OnZip" />
                                <Button x:Name="CleanButton" Content="Remove Metadata" Click="OnClean" />
                                <Button x:Name="QrButton" Content="Read QR Codes" Click="OnQr" />
                                <Button x:Name="FloatButton" Content="Float Files" Click="OnFloat" ToolTip="Keeps the files on a small always-on-top shelf you can drag them out of" />
                                <Button x:Name="CancelTools" Content="Cancel" Click="OnCancel" />
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Files -->
            <Grid>
                <Border x:Name="EmptyState" Style="{StaticResource GlassCard}" CornerRadius="24">
                    <Grid>
                        <Rectangle x:Name="DashedBorder" Margin="12" RadiusX="18" RadiusY="18" StrokeThickness="2" StrokeDashArray="5 4" Stroke="#808B5CF6" IsHitTestVisible="False" />
                        <Viewbox StretchDirection="DownOnly" Margin="24,20">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Grid Width="230" Height="176" HorizontalAlignment="Center">
                                <Canvas x:Name="Orbit" Width="230" Height="176" />
                                <Ellipse x:Name="RingA" Width="84" Height="84" Stroke="#808B5CF6" StrokeThickness="2" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform><ScaleTransform /></Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse x:Name="RingB" Width="84" Height="84" Stroke="#80EC4899" StrokeThickness="2" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform><ScaleTransform /></Ellipse.RenderTransform>
                                </Ellipse>
                                <Grid x:Name="Core" Width="84" Height="84" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform><ScaleTransform /></Grid.RenderTransform>
                                    <Ellipse Fill="{StaticResource Brand}">
                                        <Ellipse.Effect>
                                            <DropShadowEffect BlurRadius="26" ShadowDepth="4" Direction="270" Opacity="0.5" Color="#8B5CF6" />
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <TextBlock x:Name="CoreGlyph" Text="⇄" Foreground="White" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               RenderTransformOrigin="0.5,0.5" Margin="0,-4,0,0">
                                        <TextBlock.RenderTransform><RotateTransform /></TextBlock.RenderTransform>
                                    </TextBlock>
                                </Grid>
                            </Grid>
                            <TextBlock x:Name="DropTitle" Text="Drop anything here" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            <TextBlock Text="Images, video, audio, PDFs, documents, e-books, spreadsheets, presentations, subtitles and archives"
                                       Foreground="{StaticResource Secondary}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420" Margin="0,6,0,14" />
                            <Button Style="{StaticResource Primary}" Content="＋  Choose Files" HorizontalAlignment="Center" Padding="22,8" Click="OnAddFiles" />
                            <Border Background="#0D1E1B3A" CornerRadius="12" Padding="12,6" Margin="0,14,0,0" HorizontalAlignment="Center">
                                <TextBlock x:Name="WheelTip" Style="{StaticResource Caption}" TextAlignment="Center" MaxWidth="460" />
                            </Border>
                        </StackPanel>
                        </Viewbox>
                    </Grid>
                </Border>
                <ListBox x:Name="FileList" ItemTemplate="{StaticResource JobRow}" ItemContainerStyle="{StaticResource RowContainer}" Visibility="Collapsed"
                         BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionMode="Extended" KeyDown="OnListKey" />
                <Border x:Name="DropHighlight" BorderBrush="{StaticResource Brand}" BorderThickness="3" CornerRadius="20" Background="#148B5CF6"
                        Visibility="Collapsed" IsHitTestVisible="False" />
            </Grid>
        </DockPanel>
    </Grid>
</Window>
