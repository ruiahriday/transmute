<Project Sdk="Microsoft.NET.Sdk">
  <!-- Every converter lives here. It is plain .NET (no Windows UI), so the self-test can run it
       headless on any machine, and the app (Transmute) adds the windows on top. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Transmute</RootNamespace>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.17.2" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="PDFsharp-MigraDoc" Version="6.2.4" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="PDFtoImage" Version="5.3.0" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.4.1" />
    <PackageReference Include="ExcelDataReader" Version="3.8.0" />
    <PackageReference Include="SharpCompress" Version="0.50.6" />
    <PackageReference Include="ZXing.Net" Version="0.16.10" />
    <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
    <PackageReference Include="Markdig" Version="1.4.0" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
  </ItemGroup>
  <!-- "Create link" (ShareLinks.cs): the service's address and the app token, baked in when the
       build has them (environment variables SpinformLinkService / SpinformLinkToken on CI). -->
  <ItemGroup Condition="'$(SpinformLinkService)' != '' And '$(SpinformLinkToken)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SpinformLinkService</_Parameter1>
      <_Parameter2>$(SpinformLinkService)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SpinformLinkToken</_Parameter1>
      <_Parameter2>$(SpinformLinkToken)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <!-- The background-removal network (windows/models, downloaded by the build from the
         windows-models branch). It is copied next to the app and the self-test. -->
    <None Include="..\..\models\*.onnx" Link="models\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('..\..\THIRD-PARTY-NOTICES.txt')" />
  </ItemGroup>
</Project>
